{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(docs/**)",
      "Read(secrets/**)",
      "Write"
    ],
    "allow": [
      "Bash(ls *)",
      "Bash(npm test)",
      "mcp__puppeteer",
      "Edit(//tmp/scratch/**)",
      "Read(~/Documents/*.pdf)",
      "Edit(docs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__memory__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/shared-audit.sh",
            "args": []
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/shared-audit.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
