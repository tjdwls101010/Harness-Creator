{"nodes": [{"id": "docs_wiki_explanation_design_principles_harness_mental_model", "label": "Harness Mental Model", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project outcomes depend on model capability plus repository context, procedures, tools, and controls that are not contained in model weights or one-off prompts."}, {"id": "docs_wiki_explanation_design_principles_judgment_and_verified_boundaries", "label": "Judgment and Verified Boundaries", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case-sensitive decisions should use model judgment, while crisp unacceptable states should be verified or blocked by deterministic controls."}, {"id": "docs_wiki_explanation_design_principles_harness_surfaces", "label": "Harness as a System of Surfaces", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The smallest useful combination of context, rules, skills, controls, agents, workflows, and a spec is preferable to generating every possible surface."}, {"id": "docs_wiki_explanation_design_principles_progressive_disclosure", "label": "Progressive Disclosure", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always-loaded context competes with task evidence; detail should load only at a reliable branch where it becomes relevant."}, {"id": "docs_wiki_explanation_design_principles_persisted_rationale_and_evidence", "label": "Persisted Rationale and Evidence", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configuration alone does not preserve rejected alternatives, user intent, validation evidence, or lifecycle history, so the harness spec persists them."}, {"id": "docs_wiki_explanation_design_principles_empirical_rule_reduction", "label": "Empirical Rule Reduction", "file_type": "rationale", "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlapping constraints may be removed only with evaluation; Anthropic's reported reduction is evidence for an empirical method, not a universal percentage or performance claim."}], "edges": [{"source": "docs_wiki_explanation_design_principles_harness_mental_model", "target": "docs_wiki_explanation_design_principles_harness_surfaces", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a71\u20133", "weight": 1.0}, {"source": "docs_wiki_explanation_design_principles_judgment_and_verified_boundaries", "target": "docs_wiki_explanation_design_principles_harness_surfaces", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a72\u20133", "weight": 1.0}, {"source": "docs_wiki_explanation_design_principles_harness_surfaces", "target": "docs_wiki_explanation_design_principles_progressive_disclosure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wiki/explanation/design-principles.md", "source_location": "\u00a73\u20134", "weight": 1.0}, {"source": "docs_wiki_explanation_design_prin