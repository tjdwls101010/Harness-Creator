{"nodes": [{"id": "docs_wiki_explanation_layer_routing_three_axis_routing", "label": "Three-Axis Layer Routing", "file_type": "rationale", "source_file": "docs/wiki/explanation/layer-routing.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each need is routed by required authority, load timing, and recurring cost, with an additional redundancy check against existing controls."}, {"id": "docs_wiki_explanation_layer_routing_need_first_routing", "label": "Need-First Routing", "file_type": "rationale", "source_file": "docs/wiki/explanation/layer-routing.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inventorying user needs before proposing components prevents available Claude Code surfaces from dictating the design."}, {"id": "docs_wiki_explanation_layer_routing_authority_routing", "label": "Authority Routing", "file_type": "rationale", "source_file": "docs/wiki/explanation/layer-routing.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Advice belongs in context, reusable procedures in skills, and non-negotiable behavior in justified deterministic controls."}, {"id": "docs_wiki_explanation_layer_routing_load_timing_routing", "label": "Load-Timing Routing", "file_type": "rationale", "source_file": "docs/wiki/explanation/layer-routing.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A layer should load at the latest reliable point that still presents required guidance when it is needed."}, {"id": "docs_wiki_explanation_layer_routing_cost_aware_routing", "label": "Cost-Aware Routing", "file_type": "rationale", "source_file": "docs/wiki/explanation/layer-routing.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor":